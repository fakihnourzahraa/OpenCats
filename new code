UPDATE candidate_joborder_status SET short_description = 'Interview 1'        WHERE candidate_joborder_status_id = 300;
UPDATE candidate_joborder_status SET short_description = 'Interview 2'        WHERE candidate_joborder_status_id = 400;
UPDATE candidate_joborder_status SET short_description = 'Job offered'        WHERE candidate_joborder_status_id = 600;
UPDATE candidate_joborder_status SET short_description = 'Job offer refused'  WHERE candidate_joborder_status_id = 700;
